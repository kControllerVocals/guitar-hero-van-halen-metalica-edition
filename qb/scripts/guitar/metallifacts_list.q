		}
		{
			time = 125.0
			text = qs("'Women and Children First' contains the hidden track 'Growth,' originally intended to start the band's next album 'Fair Warning.'  Instead, the short instrumental piece appeared at the end of 'In a Simple Rhyme.'")
		}
		{
			time = 150.0
			text = qs("The 'Women and Children First' album was comprised entirely of original band compositions, a first for Van Halen.")
