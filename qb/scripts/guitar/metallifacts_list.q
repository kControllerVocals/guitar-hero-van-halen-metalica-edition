AintTalkinBoutLove_metallifacts = {
	array = [
		{
			time = 4.0
			text = qs("'Ain't Talkin' 'Bout Love' starts with an arpeggiated chord progression in the key of A minor.  Eddie actually played a wrong note during the intro but decided to keep it for the record.")
		}
		{
			time = 30.0
			text = qs("'Loss of Control,' a song written to mock the newly emerging punk scene, was written by Eddie at the same time as 'Ain't Talkin' 'Bout Love.'")
		}
		{
			time = 65.0
			text = qs("Eddie wrote 'Ain't Talkin' 'Bout Love' a year before their debut album 'Van Halen' was released.")
		}
		{
			time = 100.0
			text = qs("'Ain't Talkin' 'Bout Love' and 'Loss of Control' were written in one day, cartooning on punk.")
		}
		{
			time = 130.0
			text = qs("The 'Van Halen' album, produced by Ted Templeman at Sunset Sound Studios in Hollywood, was released in February, 1978.")
		}
		{
			time = 150.0
			text = qs("The 'Van Halen' album is a truly influential record, which stretched the boundaries of guitar rock, and introduced the world to Eddie Van Halen, who would go on to prove himself as one of the greatest rock guitarists ever.")
		}
		{
			time = 170.0
			text = qs("The solo has a somewhat middle-eastern sound, thanks to Eddie's use of an electric sitar.")
		}
		{
			time = 190.0
			text = qs("The Whisky a Go Go night club in West Hollywood, California was the backdrop for the photos featured on the 'Van Halen' album cover.")
		}
		{
			time = 210.0
			clear_text
		}
	]
}
